  "main": "worker.mjs",
  "compatibility_date": "2026-10-04",
  "env": {
    "development": {
      "name": "replace-with-existing-development-worker",
      "account_id": "REPLACE_WITH_EXISTING_ACCOUNT_ID",
      "vars": {
