{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.melavern/api-key-case",
  "title": "API Key Case",
  "description": "Local MCP tools for secret status and guarded deployment. Values never reach the agent.",
  "repository": {
    "url": "https://github.com/melavern/api-key-case",
    "source": "github"
  },
  "websiteUrl": "https://apikeycase.melavern.com/",
  "version": "0.9.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "api-key-case",
      "version": "0.9.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
